<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>PearlrockBots.SqueezeBreakout</RootNamespace>
    <AssemblyName>XAUUSD Squeeze Breakout v1</AssemblyName>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!--
    cTrader Automate generates its own .csproj when you import a cBot.
    This file allows the multi-file project to compile outside cTrader for
    code review and so the test project can link Core/*.cs.
  -->
  <ItemGroup>
    <PackageReference Include="cTrader-Automate" Version="*" Condition="false" />
  </ItemGroup>

</Project>
